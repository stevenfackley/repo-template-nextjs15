# {{PROJECT_NAME}} — required env. Copy to .env.local (dev) or .env (prod, chmod 600).
NODE_ENV=development
PORT=3000

# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# DATABASE_URL=
# AUTH_SECRET=

# S3-compatible object storage (optional). Enable by setting all five.
# Cloudflare R2 in prod: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# MinIO locally: S3_ENDPOINT=http://localhost:9000
# S3_ENDPOINT=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_BASE_URL=
